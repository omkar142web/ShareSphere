<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ShareSphere - Campus Carpool</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <nav class="navbar">
    <a href="/" class="logo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 17a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2"/>
        <path d="M9 17h6"/>
        <circle cx="7" cy="17" r="2"/>
        <circle cx="17" cy="17" r="2"/>
      </svg>
      ShareSphere
    </a>
    <div class="nav-links">
      <a href="/login">Log in</a>
      <a href="/register" class="btn btn-primary">Get Started</a>
    </div>
  </nav>

  <section class="hero">
    <h1>Share the Ride.<br>Save the Planet.</h1>
    <p>Connect with students at your college and carpool to reduce your carbon footprint. Every shared ride earns eco points.</p>
    <div class="btn-group">
      <a href="/register" class="btn btn-primary" style="padding:0.8rem 2rem;font-size:1rem">Join Now</a>
      <a href="/login" class="btn btn-outline" style="padding:0.8rem 2rem;font-size:1rem">Sign In</a>
    </div>
  </section>

  <section class="features">
    <div class="card feature-card">
      <span class="icon">🌍</span>
      <h3>Eco-Friendly Impact</h3>
      <p>Every shared ride reduces CO2 emissions. Earn eco points and track your positive impact on the environment.</p>
    </div>
    <div class="card feature-card">
      <span class="icon">🎓</span>
      <h3>Campus Exclusive</h3>
      <p>Verified college email required. Ride safely with fellow students from your campus community.</p>
    </div>
    <div class="card feature-card">
      <span class="icon">🌟</span>
      <h3>Gamified Rewards</h3>
      <p>Earn points for posting and joining rides. Build your eco score and become a campus sustainability champion.</p>
    </div>
  </section>

  <script src="/js/main.js"></script>
</body>
</html>
