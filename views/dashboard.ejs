<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Dashboard' }) %>
</head>
<body>
  <%- include('partials/navbar', { active: 'dashboard', user: user }) %>

  <div class="dashboard-header">
    <div>
      <h1>Available rides</h1>
      <p>Welcome back, <strong><%= user.name %></strong></p>
    </div>
  </div>

  <div class="stats">
    <div class="stat-card">
      <div class="stat-label">Total rides</div>
      <div class="stat-value"><%= rides.length %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Your eco score</div>
      <div class="stat-value"><%= user.eco_score || 0 %></div>
    </div>
  </div>

  <% if (rides.length === 0) { %>
    <div class="empty-state">
      <span class="empty-icon">🚗</span>
      <h3>No rides available yet</h3>
      <p>Be the first to post one for your route.</p>
      <a href="/post-ride" class="btn btn-primary" style="margin-top:1rem">Post a ride</a>
    </div>
  <% } else { %>
    <div class="rides-grid">
      <% rides.forEach(function(ride) { %>
        <div class="card ride-card">
          <div class="route">
            <span class="location"><%= ride.origin %></span>
            <span class="arrow" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
            <span class="location"><%= ride.destination %></span>
          </div>

          <div class="route-line" aria-hidden="true">
            <span class="node origin"></span>
            <span class="track"></span>
            <span class="node destination"></span>
          </div>

          <div class="meta">
            <span><%= new Date(ride.time).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %></span>
            <span class="<%= ride.availableSeats > 0 ? 'seats-left' : 'seats-full' %>">
              <%= ride.availableSeats %>/<%= ride.totalSeats %> seats
            </span>
          </div>

          <div class="driver">
            Driver: <strong><%= ride.driverName %></strong>
          </div>

          <% if (ride.passengers.length > 0) { %>
            <div class="passengers">
              Passengers:
              <% ride.passengers.forEach(function(p) { %>
                <span class="passenger-tag"><%= p.name %></span>
              <% }); %>
            </div>
          <% } %>

          <div class="card-actions">
            <% if (ride.driverEmail === user.email) { %>
              <button class="btn btn-danger btn-sm btn-delete-ride" data-ride-id="<%= ride._id %>">
                <span class="btn-label">Delete</span>
                <span class="spinner" aria-hidden="true"></span>
              </button>
            <% } else if (ride.hasJoined) { %>
              <button class="btn btn-outline btn-sm btn-leave" data-ride-id="<%= ride._id %>">
                <span class="btn-label">Cancel join</span>
                <span class="spinner" aria-hidden="true"></span>
              </button>
            <% } else if (ride.availableSeats > 0) { %>
              <button class="btn btn-primary btn-sm btn-join" data-ride-id="<%= ride._id %>">
                <span class="btn-label">Join ride</span>
                <span class="spinner" aria-hidden="true"></span>
              </button>
            <% } else { %>
              <span class="status-pill">Full</span>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <%- include('partials/footer') %>
</body>
</html>
