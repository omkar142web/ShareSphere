<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Log in' }) %>
</head>
<body>
  <%- include('partials/navbar', { active: 'login' }) %>

  <div class="form-page">
    <div class="form-container">
      <h1>Welcome back</h1>
      <p class="subtitle">Log in to find rides and earn eco points.</p>

      <form id="loginForm" method="POST" action="/login" data-ajax>
        <div class="form-error" id="loginError"></div>
        <div class="form-group">
          <label for="email">Email address</label>
          <input required type="email" id="email" name="email" placeholder="you@college.com" autocomplete="email" />
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input required type="password" id="password" name="password" placeholder="Enter your password" autocomplete="current-password" />
        </div>
        <button class="btn btn-primary btn-block" type="submit" style="padding:0.75rem;font-size:1rem">
          <span class="btn-label">Log in</span>
          <span class="spinner" aria-hidden="true"></span>
        </button>
      </form>

      <div class="form-footer">
        No account yet? <a href="/register">Sign up</a>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
