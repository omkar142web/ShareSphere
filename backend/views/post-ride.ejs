<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Post a Ride - ShareSphere</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <nav class="navbar">
    <a href="/" class="logo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 17a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2"/>
        <path d="M9 17h6"/>
        <circle cx="7" cy="17" r="2"/>
        <circle cx="17" cy="17" r="2"/>
      </svg>
      ShareSphere
    </a>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <span class="eco-badge"><%= user.eco_score || 0 %> pts</span>
      <a href="/logout">Logout</a>
    </div>
  </nav>

  <div class="form-container" style="margin-top:2rem">
    <h1>Post a Ride</h1>
    <p class="subtitle">Earn 10 eco points for each ride you share!</p>

    <form id="postRideForm" method="POST" data-ajax>
      <div class="form-error" id="postRideError"></div>
      <div class="form-group">
        <label for="origin">From</label>
        <input required type="text" id="origin" name="origin" placeholder="e.g. North Campus" />
      </div>
      <div class="form-group">
        <label for="destination">To</label>
        <input required type="text" id="destination" name="destination" placeholder="e.g. Downtown" />
      </div>
      <div class="form-group">
        <label for="time">Departure Time</label>
        <input required type="datetime-local" id="time" name="time" />
      </div>
      <div class="form-group">
        <label for="totalSeats">Available Seats</label>
        <input required type="number" id="totalSeats" name="totalSeats" min="1" max="8" placeholder="e.g. 3" />
      </div>
      <button class="btn btn-primary" type="submit" style="width:100%;padding:0.75rem;font-size:1rem">Post Ride</button>
    </form>

    <div class="form-footer">
      <a href="/dashboard">&larr; Back to Dashboard</a>
    </div>
  </div>

  <script src="/js/main.js"></script>
</body>
</html>
