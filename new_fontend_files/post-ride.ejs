<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Post a ride' }) %>
</head>
<body>
  <%- include('partials/navbar', { active: 'post-ride', user: user }) %>

  <div class="form-page">
    <div class="form-container">
      <h1>Post a ride</h1>
      <p class="subtitle">Earn 10 eco points for each ride you share!</p>

      <form id="postRideForm" method="POST" action="/rides" data-ajax>
        <div class="form-error" id="postRideError"></div>
        <div class="form-group">
          <label for="origin">From</label>
          <input required type="text" id="origin" name="origin" placeholder="e.g. North Campus" />
        </div>
        <div class="form-group">
          <label for="destination">To</label>
          <input required type="text" id="destination" name="destination" placeholder="e.g. Downtown" />
        </div>
        <div class="form-group">
          <label for="time">Departure time</label>
          <input required type="datetime-local" id="time" name="time" />
        </div>
        <div class="form-group">
          <label for="totalSeats">Available seats</label>
          <input required type="number" id="totalSeats" name="totalSeats" min="1" max="8" placeholder="e.g. 3" />
        </div>
        <button class="btn btn-primary btn-block" type="submit" style="padding:0.75rem;font-size:1rem">
          <span class="btn-label">Post ride</span>
          <span class="spinner" aria-hidden="true"></span>
        </button>
      </form>

      <div class="form-footer">
        <a href="/dashboard">&larr; Back to dashboard</a>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
