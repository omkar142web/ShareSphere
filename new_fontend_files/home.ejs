<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Campus Carpool' }) %>
</head>
<body>
  <%- include('partials/navbar', { active: 'home' }) %>

  <section class="hero">
    <div>
      <span class="hero-eyebrow">● Verified students only</span>
      <h1>Share the ride.<br><em>Save the planet.</em></h1>
      <p class="lead">Connect with students at your college and carpool to reduce your carbon footprint. Every shared ride earns eco points.</p>
      <div class="btn-group">
        <a href="/register" class="btn btn-primary btn-block" style="width:auto;padding:0.8rem 2rem;font-size:1rem">Join Now</a>
        <a href="/login" class="btn btn-outline" style="padding:0.8rem 2rem;font-size:1rem">Sign In</a>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="route-card is-active">
        <div class="stops"><span>North Campus</span><span>Downtown</span></div>
        <div class="route-line">
          <span class="node origin"></span>
          <span class="track"></span>
          <span class="node destination"></span>
        </div>
        <div class="footnote"><span>7:45 AM</span><span>3 seats left</span></div>
      </div>
      <div class="route-card">
        <div class="stops"><span>Maple Hall</span><span>Library</span></div>
        <div class="route-line">
          <span class="node origin"></span>
          <span class="track"></span>
          <span class="node destination"></span>
        </div>
        <div class="footnote"><span>9:10 AM</span><span>1 seat left</span></div>
      </div>
    </div>
  </section>

  <section class="features">
    <div class="card feature-card">
      <div class="stop-marker"><span class="dot"></span><span class="label">Why it works — 1</span></div>
      <span class="icon">🌍</span>
      <h3>Eco-friendly impact</h3>
      <p>Every shared ride reduces CO2 emissions. Earn eco points and track your positive impact on the environment.</p>
    </div>
    <div class="card feature-card">
      <div class="stop-marker"><span class="dot"></span><span class="label">Why it works — 2</span></div>
      <span class="icon">🎓</span>
      <h3>Campus exclusive</h3>
      <p>Verified college email required. Ride safely with fellow students from your campus community.</p>
    </div>
    <div class="card feature-card">
      <div class="stop-marker"><span class="dot"></span><span class="label">Why it works — 3</span></div>
      <span class="icon">🌟</span>
      <h3>Gamified rewards</h3>
      <p>Earn points for posting and joining rides. Build your eco score and become a campus sustainability champion.</p>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
